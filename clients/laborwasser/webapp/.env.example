# Labor Wasser de Mexico webapp — environment variables.
#
# Copy this file to:
#   .env.development  for local dev
#   .env.production   for prod deploy

# Backend API base URL (erpapi.laborwasserdemexico.com in prod, api-base local in dev).
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
# Optional override if the image host differs from the API host.
# NEXT_PUBLIC_API_HOST=

# Sanctum cookie domain (matches SESSION_DOMAIN in the backend .env).
NEXT_PUBLIC_SESSION_DOMAIN=laborwasserdemexico.com

# Currency (matches AppSetting `currency.base_currency` in DB).
NEXT_PUBLIC_CURRENCY=MXN

# Stripe (test keys for dev; production keys live in .env.production only).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public site canonical (used for SEO + redirects).
NEXT_PUBLIC_CANONICAL_HOST=https://laborwasserdemexico.com
