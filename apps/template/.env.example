# ---------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------

# Required. Base URL of the Laravel api-base instance this template talks to.
# All API calls go to ${NEXT_PUBLIC_BACKEND_URL}/api/v1/...
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Optional. Hostname allowed for next/image when serving product/storage
# images. Defaults to the same host as NEXT_PUBLIC_BACKEND_URL. Override
# only if your image CDN/host differs from your API host.
# NEXT_PUBLIC_API_HOST=https://erpapi.example.com

# ---------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------

# Sanctum stateful session domain (cookies). Match your frontend domain.
NEXT_PUBLIC_SESSION_DOMAIN=localhost

# ---------------------------------------------------------------------
# Money
# ---------------------------------------------------------------------

# ISO-4217 currency code shown by default in the UI. The backend overrides
# this per item via the currency relationship.
NEXT_PUBLIC_CURRENCY=MXN

# ---------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------

# Stripe publishable key (safe to expose to the client).
# Tenants ship their own production key in their client repo's .env.production.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
