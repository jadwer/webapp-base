# pnpm settings
auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false

# GitHub Packages registry for @lwm scope (used in Fase 0+ when publishing)
# To authenticate locally, set NPM_TOKEN env var or run:
#   echo "//npm.pkg.github.com/:_authToken=YOUR_PAT" >> ~/.npmrc
@lwm:registry=https://npm.pkg.github.com
