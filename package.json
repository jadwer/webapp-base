{
  "name": "lwm-codebase",
  "version": "0.0.0",
  "private": true,
  "description": "LWM monorepo. Master alive (apps/template) + shared @lwm/* packages consumed by client repos.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter ./apps/template dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter './packages/*' build",
    "build:template": "pnpm --filter ./apps/template build",
    "test": "pnpm -r test",
    "test:template": "pnpm --filter ./apps/template test:run",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist .next .turbo node_modules/.cache",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build:packages && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
