{
  "name": "lwm-codebase",
  "version": "0.0.0",
  "private": true,
  "description": "LWM monorepo. Master alive (apps/template) + shared @lwm/* packages consumed by client repos.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter ./apps/template dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter './packages/*' build",
    "build:template": "pnpm --filter ./apps/template build",
    "test": "pnpm -r test",
    "test:template": "pnpm --filter ./apps/template test:run",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist .next .turbo node_modules/.cache",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build:packages && changeset publish",
    "check:parity": "bash scripts/check-parity.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "next": "15.5.28",
      "react": "19.1.10",
      "react-dom": "19.1.10",
      "follow-redirects": "^1.16.1",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "immutable@>=5.0.0 <5.1.8": "^5.1.8",
      "nanoid@<3.3.18": "^3.3.18",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "postcss@<8.5.23": "^8.5.23",
      "source-map-js": "^1.2.2",
      "underscore": "^1.13.8",
      "@babel/core@<7.29.6": "^7.29.6",
      "sharp@<0.35.5": "^0.35.5"
    }
  }
}
